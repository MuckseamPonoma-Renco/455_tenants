<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>tenant-issue-os.bootstrap</string>
  <key>ProgramArguments</key><array><string>__REPO_ROOT__/scripts/run_background_bootstrap.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/bootstrap.out.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/bootstrap.err.log</string>
</dict></plist>
